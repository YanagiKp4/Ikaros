# Supabase project URL.
SUPABASE_URL=https://your-project.supabase.co

# Public key for normal authenticated operations.
SUPABASE_PUBLIC_KEY=your-public-key

# Privileged key used only by the reminder worker.
SUPABASE_WORKER_KEY=your-worker-secret-key

# Positive worker interval in seconds.
REMINDER_WORKER_INTERVAL_SECONDS=10

# Positive maximum number of reminders processed per cycle.
REMINDER_WORKER_BATCH_SIZE=10
